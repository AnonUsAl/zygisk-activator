<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 风格图标底：自上而下由亮到深的蓝色渐变 + 顶部一层柔光，
     不用描边、不用投影，靠色彩本身给体积感。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#66B8FF"
                android:endColor="#0A56EE" />
        </aapt:attr>
    </path>

    <!-- 顶部柔光：iOS 图标常见的高光，渐隐到透明，不会留硬边 -->
    <path android:pathData="M0,0h108v56h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="56"
                android:startColor="#3DFFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
